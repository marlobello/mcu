{
  "name": "munch-classics-universe-api",
  "version": "1.0.0",
  "description": "Azure Functions API for Munch Classics Universe.",
  "type": "module",
  "main": "dist/src/{index.js,functions/*.js}",
  "scripts": {
    "build": "rimraf dist && tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run build",
    "start": "func start",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.1",
    "@azure/functions": "^4.16.2",
    "@azure/identity": "^4.13.0",
    "@azure/monitor-opentelemetry": "^1.14.0",
    "jose": "^6.2.1"
  },
  "devDependencies": {
    "azure-functions-core-tools": "^4.x",
    "@types/node": "^26.x",
    "typescript": "^7.0.2",
    "rimraf": "^6.1.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}